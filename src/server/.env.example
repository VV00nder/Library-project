# Скопируйте в .env и заполните. Файл .env не коммитится.
PORT=3001
# Адрес HTTP-сервиса BibliusAPI опубликованной базы 1С
ONEC_URL=http://localhost/Biblius/hs/biblius
# Служебный пользователь 1С с ролью ОбменБиблиус
ONEC_USER=biblius_exchange
ONEC_PASSWORD=
# Срок жизни сессии веб-приложения, часов
SESSION_HOURS=8
# Почта для кодов подтверждения и напоминаний (FR-20). Если не задано — письма складываются в server\outbox
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# За сколько дней до срока напоминать и во сколько (по Москве) запускать рассылку
REMIND_DAYS=3
NOTIFY_TIME=09:00
