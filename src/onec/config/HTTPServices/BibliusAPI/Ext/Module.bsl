Функция PingGET(Запрос) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("ok", Истина);
    Данные.Вставить("source", "1C");
    Данные.Вставить("message", "pong");
    Данные.Вставить("server_time", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd'T'HH:mm:ss"));
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Тело = Запись.Закрыть();
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.Заголовки.Вставить("Cache-Control", "no-store");
    Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции

Функция DataRequest(Запрос) Экспорт
 Возврат БиблиусДанные.Обработать(Запрос);
КонецФункции
