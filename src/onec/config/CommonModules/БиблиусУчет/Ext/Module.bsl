  КонецЕсли;
  СтрокаДок=Документ.Строки.Добавить(); СтрокаДок.Экземпляр=Книга; СтрокаДок.Стоимость=Книга.Стоимость;
  Документ.ДополнительныеСвойства.Вставить("ИсполнительВеб",Исполнитель.Код); Документ.Записать(РежимЗаписиДокумента.Проведение);
  Возврат Новый Структура("writeoff_id,book_code,status",Документ.ВнешнийКод,Книга.Код,"Списан");
 Иначе Ошибка(404,"Ресурс не найден");
 КонецЕсли;
