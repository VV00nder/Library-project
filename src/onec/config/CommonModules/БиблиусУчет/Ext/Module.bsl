КонецФункции

// Публичный каталог: без стоимости и учётных сведений, без списанных и помеченных на удаление экземпляров.
Функция ПубличныйКаталог() Экспорт
 Список = Новый Массив;
 Выдачи = Новый Соответствие;
 ЗапросВыдач = Новый Запрос("ВЫБРАТЬ Экземпляр КАК Экземпляр, КОЛИЧЕСТВО(Ссылка) КАК Количество ИЗ Документ.Выдача ГДЕ Проведен СГРУППИРОВАТЬ ПО Экземпляр");
 ВыборкаВыдач = ЗапросВыдач.Выполнить().Выбрать();
 Пока ВыборкаВыдач.Следующий() Цикл Выдачи.Вставить(ВыборкаВыдач.Экземпляр, ВыборкаВыдач.Количество); КонецЦикла;
 Выборка = Справочники.Экземпляры.Выбрать();
 Пока Выборка.Следующий() Цикл
  Если Выборка.ПометкаУдаления Или Выборка.Состояние = Перечисления.СостоянияЭкземпляров.Списан Или Не ЗначениеЗаполнено(Выборка.ДатаПоступления) Тогда Продолжить; КонецЕсли;
  Количество = Выдачи.Получить(Выборка.Ссылка); Если Количество = Неопределено Тогда Количество = 0; КонецЕсли;
  Элемент = Новый Структура("book_code,title,author,publication_year,udc,status,received_date,loans_count",Выборка.Код,Выборка.Наименование,Выборка.Автор,Выборка.ГодИздания,Выборка.УДК,Строка(Выборка.Состояние),ДатаСтрокой(Выборка.ДатаПоступления),Количество);
  ДобавитьОписание(Элемент, Выборка);
  Список.Добавить(Элемент);
 КонецЦикла;
 Возврат Новый Структура("items,total",Список,Список.Количество());
КонецФункции

Функция СейчасСтрокой()
 Возврат Формат(ТекущаяДата(),"ДФ=yyyy-MM-dd'T'HH:mm:ss");
КонецФункции

Функция ЗаявкаJSON(З) Экспорт
 Читатель = Справочники.Читатели.НайтиПоКоду(З.Читатель);
 Возврат Новый Структура("request_id,reader_id,full_name,group,edition_key,title,author,created,status,loan_id,updated,comment",З.Заявка,З.Читатель,Читатель.Наименование,Читатель.Группа,З.КлючИздания,З.Название,З.Автор,З.Создана,З.Состояние,З.Выдача,З.Изменена,З.Комментарий);
КонецФункции

Процедура АудитЗаявки(Исполнитель, Ключ, Действие)
 Запись = РегистрыСведений.ЖурналОпераций.СоздатьМенеджерЗаписи();
 Запись.Событие = Строка(Новый УникальныйИдентификатор);
 Запись.ВремяСобытия = Формат(ТекущаяУниверсальнаяДата(),"ДФ=yyyy-MM-dd'T'HH:mm:ss")+"+00:00";
 Запись.Исполнитель = Исполнитель.Код; Запись.Объект = "Заявка"; Запись.КлючОбъекта = Ключ; Запись.Действие = Действие;
 Запись.Записать();
КонецПроцедуры

Функция ЗаписьЗаявки(Запрос, Исполнитель, Данные)
 Ид = Запрос.ПараметрыЗапроса.Получить("id"); Действие = Запрос.ПараметрыЗапроса.Получить("action");
 Если Ид = Неопределено Тогда
  Если Исполнитель.Роль <> Перечисления.РолиВеб.Читатель Или Не ЗначениеЗаполнено(Исполнитель.Читатель) Тогда Ошибка(403,"Заявку оставляет читатель"); КонецЕсли;
  Значение = Неопределено;
  Если Не Данные.Свойство("request_id",Значение) Или Не Данные.Свойство("edition_key",Значение) Или Не Данные.Свойство("title",Значение) Тогда Ошибка(400,"Не указано издание"); КонецЕсли;
  КодЧитателя = Исполнитель.Читатель.Код; Активных = 0;
  Выборка = РегистрыСведений.ЗаявкиНаВыдачу.Выбрать();
  Пока Выборка.Следующий() Цикл
   Если Выборка.Читатель <> КодЧитателя Или Выборка.Состояние <> "Новая" Тогда Продолжить; КонецЕсли;
   Активных = Активных + 1;
   Если Выборка.КлючИздания = Данные.edition_key Тогда Ошибка(409,"Заявка на эту книгу уже оформлена"); КонецЕсли;
  КонецЦикла;
  Если Активных >= 5 Тогда Ошибка(409,"Можно оформить не больше 5 заявок одновременно"); КонецЕсли;
  З = РегистрыСведений.ЗаявкиНаВыдачу.СоздатьМенеджерЗаписи();
  З.Заявка = Данные.request_id; З.Читатель = КодЧитателя; З.КлючИздания = Данные.edition_key;
  З.Название = Данные.title; Автор = ""; Данные.Свойство("author",Автор); Если Автор=Неопределено Тогда Автор=""; КонецЕсли; З.Автор = Автор;
  З.Создана = СейчасСтрокой(); З.Изменена = З.Создана; З.Состояние = "Новая";
  З.Записать();
  АудитЗаявки(Исполнитель, З.Заявка, "Создание");
  Возврат ЗаявкаJSON(З);
 КонецЕсли;
 З = РегистрыСведений.ЗаявкиНаВыдачу.СоздатьМенеджерЗаписи(); З.Заявка = Ид; З.Прочитать();
 Если Не З.Выбран() Тогда Ошибка(404,"Заявка не найдена"); КонецЕсли;
 Если З.Состояние <> "Новая" Тогда Ошибка(409,"Заявка уже обработана"); КонецЕсли;
 Если Действие = "cancel" Тогда
  Если Исполнитель.Роль <> Перечисления.РолиВеб.Читатель Или Исполнитель.Читатель.Код <> З.Читатель Тогда Ошибка(403,"Отменить можно только свою заявку"); КонецЕсли;
  З.Состояние = "Отменена";
 ИначеЕсли Действие = "reject" Или Действие = "done" Тогда
  Если Исполнитель.Роль <> Перечисления.РолиВеб.Библиотекарь Тогда Ошибка(403,"Заявки обрабатывает библиотекарь"); КонецЕсли;
  Комментарий = ""; Данные.Свойство("comment",Комментарий); Если Комментарий=Неопределено Тогда Комментарий=""; КонецЕсли; З.Комментарий = Комментарий;
  Если Действие = "reject" Тогда
   З.Состояние = "Отклонена";
  Иначе
   КодВыдачи = ""; Данные.Свойство("loan_id",КодВыдачи); Если КодВыдачи=Неопределено Тогда КодВыдачи=""; КонецЕсли;
   Выдача = ДокументПоКоду("Выдача",КодВыдачи);
   Если Выдача = Неопределено Или Выдача.Читатель.Код <> З.Читатель Тогда Ошибка(400,"Укажите выдачу этому читателю"); КонецЕсли;
   З.Состояние = "Выдана"; З.Выдача = КодВыдачи;
  КонецЕсли;
 Иначе Ошибка(400,"Неизвестная операция с заявкой");
 КонецЕсли;
 З.Изменена = СейчасСтрокой(); З.Записать();
 АудитЗаявки(Исполнитель, З.Заявка, З.Состояние);
 Возврат ЗаявкаJSON(З);
КонецФункции

Функция ВыдачаJSON(Выдача, ДатаСреза) Экспорт
 Закрытие=Выдача.ФактическийВозврат; Если ЗначениеЗаполнено(Выдача.ДатаУтери) Тогда Закрытие=Выдача.ДатаУтери; КонецЕсли;
 Расчет=ДатаСреза; Если ЗначениеЗаполнено(Закрытие) И Закрытие<Расчет Тогда Расчет=Закрытие; КонецЕсли;
 Дни=0; Если Выдача.ДатаВыдачи<=ДатаСреза Тогда Дни=Макс(0,(Расчет-Выдача.ПлановыйВозврат)/86400); КонецЕсли;
 Активна=Выдача.ДатаВыдачи<=ДатаСреза И (Не ЗначениеЗаполнено(Закрытие) Или Закрытие>ДатаСреза);
 Возврат Новый Структура("loan_id,book_code,reader_id,full_name,group,title,author,udc,issue_date,due_date,return_date,lost_date,status,days_overdue,active",Выдача.ВнешнийКод,Выдача.Экземпляр.Код,Выдача.Читатель.Код,Выдача.Читатель.Наименование,Выдача.Читатель.Группа,Выдача.Экземпляр.Наименование,Выдача.Экземпляр.Автор,Выдача.Экземпляр.УДК,ДатаСтрокой(Выдача.ДатаВыдачи),ДатаСтрокой(Выдача.ПлановыйВозврат),ДатаСтрокой(Выдача.ФактическийВозврат),ДатаСтрокой(Выдача.ДатаУтери),Строка(Выдача.Состояние),Дни,Активна);
КонецФункции

Функция ДокументПоКоду(Вид,Код) Экспорт
 Запрос=Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ."+Вид+" ГДЕ ВнешнийКод=&Код"); Запрос.УстановитьПараметр("Код",Код);
 Выборка=Запрос.Выполнить().Выбрать(); Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
 Возврат Неопределено;
КонецФункции

Функция API(Запрос, Исполнитель, Ресурс) Экспорт
 Попытка
  Если Запрос.HTTPМетод="GET" Тогда Возврат БиблиусДанные.JSONОтвет(200, ЧтениеAPI(Запрос,Исполнитель,Ресурс)); КонецЕсли;
  Если Ресурс="writeoffs" Тогда
   Если Исполнитель.Роль<>Перечисления.РолиВеб.Бухгалтер Тогда Ошибка(403,"Списание выполняет бухгалтер"); КонецЕсли;
  ИначеЕсли Ресурс="requests" Тогда
   // права проверяются в ЗаписьЗаявки: читатель создаёт и отменяет, библиотекарь обрабатывает
  ИначеЕсли Исполнитель.Роль<>Перечисления.РолиВеб.Библиотекарь Тогда Ошибка(403,"Операция разрешена библиотекарю"); КонецЕсли;
  НачатьТранзакцию();
  Попытка
   Блокировать();
   Результат=ЗаписьAPI(Запрос,Исполнитель,Ресурс);
   ЗафиксироватьТранзакцию();
  Исключение
   ОтменитьТранзакцию(); ВызватьИсключение;
  КонецПопытки;
  Возврат БиблиусДанные.JSONОтвет(200,Результат);
 Исключение
  Описание=ОписаниеОшибки(); Код=400; Сообщение="Проверьте поля операции";
  Для Каждого Проверка Из СтрРазделить("400,403,404,409",",") Цикл
   Позиция=СтрНайти(Описание,Проверка+"|");
   Если Позиция>0 Тогда Код=Число(Проверка); Сообщение=СтрРазделить(Сред(Описание,Позиция+4),Символы.ПС)[0]; Прервать; КонецЕсли;
  КонецЦикла;
  Возврат БиблиусДанные.JSONОтвет(Код,Новый Структура("code,message","BUSINESS_ERROR",Сообщение));
 КонецПопытки;
КонецФункции

Функция ЧтениеAPI(Запрос,Исполнитель,Ресурс)
 Ид=Запрос.ПараметрыЗапроса.Получить("id");
 Список=Новый Массив;
 Если Ресурс="books" Тогда
  Если Ид<>Неопределено Тогда
   Книга=Справочники.Экземпляры.НайтиПоКоду(Ид); Если Книга.Пустая() Тогда Ошибка(404,"Экземпляр не найден"); КонецЕсли;
   Возврат КнигаJSON(Книга);
  КонецЕсли;
  Выборка=Справочники.Экземпляры.Выбрать(); Пока Выборка.Следующий() Цикл Если Не Выборка.ПометкаУдаления Тогда Список.Добавить(КнигаJSON(Выборка)); КонецЕсли; КонецЦикла;
 ИначеЕсли Ресурс="loans" Или Ресурс="me-loans" Или Ресурс="overdue" Тогда
  Если Исполнитель.Роль=Перечисления.РолиВеб.Читатель И Ресурс<>"me-loans" Тогда Ошибка(403,"Доступны только собственные выдачи"); КонецЕсли;
  Если Ресурс="me-loans" И Не ЗначениеЗаполнено(Исполнитель.Читатель) Тогда Ошибка(403,"Аккаунт не связан с читателем"); КонецЕсли;
  ДатаСреза=НачалоДня(ТекущаяДата()); Если Запрос.ПараметрыЗапроса.Получить("date")<>Неопределено Тогда ДатаСреза=ДатаИзJSON(Запрос.ПараметрыЗапроса.Получить("date")); КонецЕсли;
  Всего=0; Просрочено=0;
  Выборка=Документы.Выдача.Выбрать();
  Пока Выборка.Следующий() Цикл
   Если Не Выборка.Проведен Или Выборка.ПометкаУдаления Тогда Продолжить; КонецЕсли;
   Если Ресурс="me-loans" И Выборка.Читатель<>Исполнитель.Читатель Тогда Продолжить; КонецЕсли;
   ФильтрЧитателя=Запрос.ПараметрыЗапроса.Получить("reader_id");
   Если Ресурс<>"me-loans" И ФильтрЧитателя<>Неопределено И Выборка.Читатель.Код<>ФильтрЧитателя Тогда Продолжить; КонецЕсли;
   Если Ид<>Неопределено И Выборка.ВнешнийКод<>Ид Тогда Продолжить; КонецЕсли;
   Карточка=ВыдачаJSON(Выборка,ДатаСреза);
   Если Ресурс="overdue" Тогда
    Если Не ФильтрВыдачи(Карточка,Запрос) Тогда Продолжить; КонецЕсли;
    Если Карточка.active Тогда Всего=Всего+1; Если Карточка.days_overdue>0 Тогда Просрочено=Просрочено+1; КонецЕсли; КонецЕсли;
    Если Не Карточка.active Или Карточка.days_overdue=0 Тогда Продолжить; КонецЕсли;
    МинДни=Запрос.ПараметрыЗапроса.Получить("min_days"); МаксДни=Запрос.ПараметрыЗапроса.Получить("max_days");
    Если МинДни<>Неопределено И Карточка.days_overdue<Число(МинДни) Тогда Продолжить; КонецЕсли;
    Если МаксДни<>Неопределено И Карточка.days_overdue>Число(МаксДни) Тогда Продолжить; КонецЕсли;
   КонецЕсли;
   Список.Добавить(Карточка);
  КонецЦикла;
  Если Ид<>Неопределено Тогда Если Список.Количество()=0 Тогда Ошибка(404,"Выдача не найдена"); КонецЕсли; Возврат Список[0]; КонецЕсли;
  Если Ресурс="overdue" Тогда
   Процент=Неопределено; Если Всего>0 Тогда Процент=Окр(Просрочено/Всего*100,2); КонецЕсли;
   Возврат Новый Структура("items,total,date,active_count,overdue_count,overdue_percent",Список,Список.Количество(),ДатаСтрокой(ДатаСреза),Всего,Просрочено,Процент);
  КонецЕсли;
 ИначеЕсли Ресурс="fund" Тогда
  Если Исполнитель.Роль<>Перечисления.РолиВеб.Бухгалтер Тогда Ошибка(403,"Финансовый отчёт доступен бухгалтеру"); КонецЕсли;
  Возврат ОтчетФонда(Запрос);
 ИначеЕсли Ресурс="overdue-stats" Тогда
  Если Исполнитель.Роль<>Перечисления.РолиВеб.Библиотекарь Тогда Ошибка(403,"Статистика доступна библиотекарю"); КонецЕсли;
  Возврат СтатистикаПросрочек(Запрос);
 ИначеЕсли Ресурс="notifications" Тогда
  Если Исполнитель.Роль<>Перечисления.РолиВеб.Библиотекарь Тогда Ошибка(403,"Журнал отправки доступен библиотекарю"); КонецЕсли;
  Возврат ЖурналОтправки();
 ИначеЕсли Ресурс="requests" Тогда
  Если Исполнитель.Роль=Перечисления.РолиВеб.Бухгалтер Тогда Ошибка(403,"Нет доступа к заявкам"); КонецЕсли;
  Фильтр=Запрос.ПараметрыЗапроса.Получить("status");
  Выборка=РегистрыСведений.ЗаявкиНаВыдачу.Выбрать();
  Пока Выборка.Следующий() Цикл
   Если Исполнитель.Роль=Перечисления.РолиВеб.Читатель И Выборка.Читатель<>Исполнитель.Читатель.Код Тогда Продолжить; КонецЕсли;
   Если Фильтр<>Неопределено И Фильтр<>"" И Выборка.Состояние<>Фильтр Тогда Продолжить; КонецЕсли;
   Список.Добавить(ЗаявкаJSON(Выборка));
  КонецЦикла;
 ИначеЕсли Ресурс="audit" Тогда
  Если Исполнитель.Роль<>Перечисления.РолиВеб.Библиотекарь Тогда Ошибка(403,"Нет доступа к журналу"); КонецЕсли;
  Выборка=РегистрыСведений.ЖурналОпераций.Выбрать(); Пока Выборка.Следующий() Цикл Список.Добавить(Новый Структура("id,timestamp,actor,action,entity,key",Выборка.Событие,Выборка.ВремяСобытия,Выборка.Исполнитель,Выборка.Действие,Выборка.Объект,Выборка.КлючОбъекта)); КонецЦикла;
 Иначе Ошибка(404,"Ресурс не найден");
 КонецЕсли;
 Возврат Новый Структура("items,total",Список,Список.Количество());
КонецФункции

Функция ФильтрВыдачиЭкспорт(Карточка,Запрос) Экспорт
 Возврат ФильтрВыдачи(Карточка,Запрос);
КонецФункции

Функция ФильтрВыдачи(Карточка,Запрос)
 Для Каждого Имя Из СтрРазделить("group,author,udc",",") Цикл
  Значение=Запрос.ПараметрыЗапроса.Получить(Имя);
  Если Значение<>Неопределено И Значение<>"" И Карточка[Имя]<>Значение Тогда Возврат Ложь; КонецЕсли;
 КонецЦикла;
 От=Запрос.ПараметрыЗапроса.Получить("from"); До=Запрос.ПараметрыЗапроса.Получить("to");
 Если От<>Неопределено И ДатаИзJSON(Карточка.issue_date)<ДатаИзJSON(От) Тогда Возврат Ложь; КонецЕсли;
 Если До<>Неопределено И ДатаИзJSON(Карточка.issue_date)>ДатаИзJSON(До) Тогда Возврат Ложь; КонецЕсли;
 Возврат Истина;
КонецФункции

Функция ЗаписьAPI(Запрос,Исполнитель,Ресурс)
 Ид=Запрос.ПараметрыЗапроса.Получить("id"); Действие=Запрос.ПараметрыЗапроса.Получить("action");
 Данные=Новый Структура; Если Запрос.HTTPМетод<>"DELETE" Тогда Данные=БиблиусДанные.ИзJSON(Запрос.ПолучитьТелоКакСтроку()); КонецЕсли;
 Если Ресурс="books" Тогда
  Если Запрос.HTTPМетод="POST" Тогда
   Если Не Справочники.Экземпляры.НайтиПоКоду(Данные.book_code).Пустая() Тогда Ошибка(409,"Код экземпляра уже существует"); КонецЕсли;
   Книга=Справочники.Экземпляры.СоздатьЭлемент(); Книга.Код=Данные.book_code;
   Книга.Наименование=Данные.title; Книга.Автор=Данные.author; Книга.УДК=Данные.udc; Книга.ГодИздания=Данные.publication_year;
   Для Каждого Поле Из Данные Цикл
    Реквизит=ПолеОписания(Поле.Ключ); Если Реквизит<>Неопределено Тогда Книга[Реквизит]=Поле.Значение; КонецЕсли;
   КонецЦикла;
   Книга.ДополнительныеСвойства.Вставить("ИсполнительВеб",Исполнитель.Код); Книга.Записать();
   Документ=Документы.Поступление.СоздатьДокумент(); Документ.ВнешнийКод="INIT-"+Книга.Код; Документ.Дата=ДатаИзJSON(Данные.received_date);
   Документ.Источник=Справочники.ИсточникиПоступления.НайтиПоКоду(Данные.source);
   СтрокаДок=Документ.Строки.Добавить(); СтрокаДок.Экземпляр=Книга.Ссылка; СтрокаДок.Стоимость=Число(Данные.cost);
   Документ.ДополнительныеСвойства.Вставить("ИсполнительВеб",Исполнитель.Код); Документ.Записать(РежимЗаписиДокумента.Проведение);
   Возврат КнигаJSON(Книга.Ссылка);
  КонецЕсли;
  Ссылка=Справочники.Экземпляры.НайтиПоКоду(Ид); Если Ссылка.Пустая() Тогда Ошибка(404,"Экземпляр не найден"); КонецЕсли;
  Книга=Ссылка.ПолучитьОбъект(); Книга.ДополнительныеСвойства.Вставить("ИсполнительВеб",Исполнитель.Код);
  Если Книга.ПометкаУдаления Тогда Ошибка(409,"Экземпляр помечен на удаление"); КонецЕсли;
  Если Запрос.HTTPМетод="DELETE" Тогда Книга.УстановитьПометкуУдаления(Истина); Возврат КнигаJSON(Книга); КонецЕсли;
  Если Запрос.HTTPМетод<>"PATCH" Тогда Ошибка(400,"Неподдерживаемый метод"); КонецЕсли;
  Для Каждого Поле Из Данные Цикл
   Если Поле.Ключ="title" Тогда Книга.Наименование=Поле.Значение;
   ИначеЕсли Поле.Ключ="author" Тогда Книга.Автор=Поле.Значение;
   ИначеЕсли Поле.Ключ="publication_year" Тогда Книга.ГодИздания=Поле.Значение;
   ИначеЕсли Поле.Ключ="udc" Тогда Книга.УДК=Поле.Значение;
   ИначеЕсли ПолеОписания(Поле.Ключ)<>Неопределено Тогда Книга[ПолеОписания(Поле.Ключ)]=Поле.Значение;
   Иначе Ошибка(400,"Поле карточки недоступно для изменения"); КонецЕсли;
  КонецЦикла;
  Книга.Записать(); Возврат КнигаJSON(Книга);
 ИначеЕсли Ресурс="loans" Тогда
  Если Запрос.HTTPМетод<>"POST" Тогда Ошибка(409,"Выдачи изменяются только возвратом или утерей"); КонецЕсли;
  Если Ид=Неопределено Тогда
   Если ДокументПоКоду("Выдача",Данные.loan_id)<>Неопределено Тогда Ошибка(409,"Код выдачи уже существует"); КонецЕсли;
   Документ=Документы.Выдача.СоздатьДокумент(); Документ.ВнешнийКод=Данные.loan_id; Документ.Дата=ДатаИзJSON(Данные.issue_date);
   Документ.ДатаВыдачи=Документ.Дата; Документ.ПлановыйВозврат=ДатаИзJSON(Данные.due_date);
   Документ.Читатель=Справочники.Читатели.НайтиПоКоду(Данные.reader_id); Документ.Экземпляр=Справочники.Экземпляры.НайтиПоКоду(Данные.book_code);
   ВозвратСтрока=Неопределено;
   Если Данные.Свойство("return_date",ВозвратСтрока) И Не ПустаяСтрока(ВозвратСтрока) Тогда Документ.ФактическийВозврат=ДатаИзJSON(ВозвратСтрока); КонецЕсли;
  Иначе
   Ссылка=ДокументПоКоду("Выдача",Ид); Если Ссылка=Неопределено Тогда Ошибка(404,"Выдача не найдена"); КонецЕсли;
   Документ=Ссылка.ПолучитьОбъект();
   Если Действие="return" Тогда Документ.ФактическийВозврат=ДатаИзJSON(Данные.return_date);
   ИначеЕсли Действие="loss" Тогда Документ.ДатаУтери=ДатаИзJSON(Данные.lost_date);
   Иначе Ошибка(400,"Неизвестная операция"); КонецЕсли;
   Если Документ.Состояние<>Перечисления.СостоянияВыдач.Активна Тогда
    Старый=Ссылка.ПолучитьОбъект(); Если Старый.ФактическийВозврат=Документ.ФактическийВозврат И Старый.ДатаУтери=Документ.ДатаУтери Тогда Возврат ВыдачаJSON(Старый,НачалоДня(ТекущаяДата())); КонецЕсли;
    Ошибка(409,"Выдача уже закрыта");
   КонецЕсли;
  КонецЕсли;
  Документ.ДополнительныеСвойства.Вставить("ИсполнительВеб",Исполнитель.Код); Документ.Записать(РежимЗаписиДокумента.Проведение);
  Возврат ВыдачаJSON(Документ,НачалоДня(ТекущаяДата()));
 ИначеЕсли Ресурс="requests" Тогда
  Если Запрос.HTTPМетод<>"POST" Тогда Ошибка(400,"Используйте POST"); КонецЕсли;
  Возврат ЗаписьЗаявки(Запрос,Исполнитель,Данные);
 ИначеЕсли Ресурс="writeoffs" Тогда
  Если Запрос.HTTPМетод<>"POST" Тогда Ошибка(400,"Используйте POST"); КонецЕсли;
  Если ДокументПоКоду("Списание",Данные.writeoff_id)<>Неопределено Тогда Ошибка(409,"Код списания уже существует"); КонецЕсли;
  Документ=Документы.Списание.СоздатьДокумент(); Документ.ВнешнийКод=Данные.writeoff_id;
  Документ.Дата=ДатаИзJSON(Данные.date); Документ.Причина=Справочники.ПричиныСписания.НайтиПоКоду(Данные.reason);
  Книга=Справочники.Экземпляры.НайтиПоКоду(Данные.book_code); Если Книга.Пустая() Тогда Ошибка(404,"Экземпляр не найден"); КонецЕсли;
  Значение=Неопределено;
  Если Данные.Свойство("loan_id",Значение) Тогда
