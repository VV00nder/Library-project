Процедура Ошибка(Код, Текст) Экспорт
 ВызватьИсключение Строка(Код) + "|" + Текст;
КонецПроцедуры

Процедура Блокировать() Экспорт
 Блокировка = Новый БлокировкаДанных;
 Блокировка.Добавить("Справочник.Экземпляры");
 Блокировка.Добавить("Документ.Выдача");
 Блокировка.Добавить("РегистрСведений.ДвижениеФонда");
 Блокировка.Заблокировать();
КонецПроцедуры

Функция ДатаИзJSON(Значение) Экспорт
 Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 10 Тогда Ошибка(400, "Ожидается дата YYYY-MM-DD"); КонецЕсли;
 Попытка
  ДатаЗначение = Дата(Число(Лев(Значение,4)), Число(Сред(Значение,6,2)), Число(Прав(Значение,2)));
 Исключение
  Ошибка(400, "Некорректная дата");
 КонецПопытки;
 Если Формат(ДатаЗначение,"ДФ=yyyy-MM-dd") <> Значение Тогда Ошибка(400,"Некорректная дата"); КонецЕсли;
 Возврат ДатаЗначение;
КонецФункции

Функция ДатаСтрокой(Значение) Экспорт
 Если Не ЗначениеЗаполнено(Значение) Тогда Возврат Неопределено; КонецЕсли;
 Возврат Формат(Значение,"ДФ=yyyy-MM-dd");
КонецФункции

Функция Деньги(Значение) Экспорт
 Если Значение=0 Тогда Возврат "0.00"; КонецЕсли;
 Возврат Формат(Значение,"ЧДЦ=2;ЧРД=.;ЧГ=0");
КонецФункции

Процедура Аудит(Объект, Вид, Ключ) Экспорт
 Исполнитель = ИмяПользователя();
 Объект.ДополнительныеСвойства.Свойство("ИсполнительВеб", Исполнитель);
 Запись = РегистрыСведений.ЖурналОпераций.СоздатьМенеджерЗаписи();
 Запись.Событие = Строка(Новый УникальныйИдентификатор);
 Запись.ВремяСобытия = Формат(ТекущаяУниверсальнаяДата(),"ДФ=yyyy-MM-dd'T'HH:mm:ss")+"+00:00";
 Запись.Исполнитель=Исполнитель; Запись.Объект=Вид; Запись.КлючОбъекта=Ключ; Запись.Действие="Запись";
 Если Объект.ПометкаУдаления Тогда Запись.Действие="ПометкаУдаления"; КонецЕсли;
 Писатель=Новый ЗаписьJSON; Писатель.УстановитьСтроку();
 Если Вид="Экземпляр" Тогда Снимок=КнигаJSON(Объект);
 ИначеЕсли Вид="Выдача" Тогда Снимок=ВыдачаJSON(Объект,НачалоДня(ТекущаяДата()));
 Иначе
  Строки=Новый Массив; Для Каждого СтрокаДок Из Объект.Строки Цикл Строки.Добавить(Новый Структура("book_code,cost",СтрокаДок.Экземпляр.Код,Деньги(СтрокаДок.Стоимость))); КонецЦикла;
  Снимок=Новый Структура("id,date,posted,items",Объект.ВнешнийКод,ДатаСтрокой(Объект.Дата),Объект.Проведен,Строки);
 КонецЕсли;
 ЗаписатьJSON(Писатель,Снимок); Запись.Изменения=Писатель.Закрыть();
 Запись.Записать();
КонецПроцедуры

Функция ЕстьДвижение(Экземпляр, Списание = Ложь) Экспорт
 Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Экземпляр ИЗ РегистрСведений.ДвижениеФонда ГДЕ Экземпляр=&Экземпляр И Списание=&Списание");
 Запрос.УстановитьПараметр("Экземпляр",Экземпляр); Запрос.УстановитьПараметр("Списание",Списание);
 Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Процедура КнигаПередЗаписью(Объект) Экспорт
 Если ПустаяСтрока(Объект.Код) Или ПустаяСтрока(Объект.Наименование) Или ПустаяСтрока(Объект.Автор) Или ПустаяСтрока(Объект.УДК) Тогда Ошибка(400,"Код, название, автор и УДК обязательны"); КонецЕсли;
 Если Объект.ГодИздания < 1 Или Объект.ГодИздания > Год(ТекущаяДата()) Тогда Ошибка(400,"Некорректный год издания"); КонецЕсли;
 Если Объект.ПометкаУдаления И ЕстьДвижение(Объект.Ссылка) Тогда Ошибка(409,"Экземпляр имеет историю поступления; используйте списание"); КонецЕсли;
 Если Не Объект.ЭтоНовый() И Не Объект.ДополнительныеСвойства.Свойство("ИзУчета") Тогда
  Старый=Объект.Ссылка.ПолучитьОбъект();
  Если Старый.Стоимость<>Объект.Стоимость Или Старый.ДатаПоступления<>Объект.ДатаПоступления Или Старый.Источник<>Объект.Источник Или Старый.Состояние<>Объект.Состояние Или Старый.Код<>Объект.Код Тогда Ошибка(409,"Стоимость, поступление, код и состояние изменяются только учётными операциями"); КонецЕсли;
 КонецЕсли;
КонецПроцедуры

Процедура ДокументПередЗаписью(Объект, Вид, РежимЗаписи) Экспорт
 Блокировать();
 Если Объект.ПометкаУдаления Тогда Ошибка(409,"Учётные документы с историей не удаляются"); КонецЕсли;
 Если Не ЗначениеЗаполнено(Объект.Дата) Или НачалоДня(Объект.Дата)>НачалоДня(ТекущаяДата()) Тогда Ошибка(400,"Дата операции не может быть будущей"); КонецЕсли;
 Если ПустаяСтрока(Объект.ВнешнийКод) Тогда Ошибка(400,"Внешний код документа обязателен"); КонецЕсли;
 Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ."+Вид+" ГДЕ ВнешнийКод=&Код И Ссылка<>&Ссылка");
 Запрос.УстановитьПараметр("Код",Объект.ВнешнийКод); Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
 Если Не Запрос.Выполнить().Пустой() Тогда Ошибка(409,"Код документа уже существует"); КонецЕсли;
 Если Не Объект.ЭтоНовый() Тогда
  Старый=Объект.Ссылка.ПолучитьОбъект();
  Если Старый.Проведен И Вид<>"Выдача" Тогда Ошибка(409,"Исправление проведённого документа требует отдельного согласованного процесса"); КонецЕсли;
  Если Старый.Проведен И РежимЗаписи<>РежимЗаписиДокумента.Проведение Тогда Ошибка(409,"Отмена проведения операции с историей запрещена"); КонецЕсли;
 КонецЕсли;
 Если Вид="Выдача" Тогда
  Если Не ЗначениеЗаполнено(Объект.Экземпляр) Или Не ЗначениеЗаполнено(Объект.Читатель) Тогда Ошибка(400,"Укажите экземпляр и читателя"); КонецЕсли;
  Если Объект.Экземпляр.ПометкаУдаления Или Объект.Читатель.ПометкаУдаления Тогда Ошибка(409,"Объект помечен на удаление"); КонецЕсли;
  Если Не ЗначениеЗаполнено(Объект.ДатаВыдачи) Или Не ЗначениеЗаполнено(Объект.ПлановыйВозврат) Или Объект.ПлановыйВозврат<Объект.ДатаВыдачи Или Объект.ДатаВыдачи>НачалоДня(ТекущаяДата()) Тогда Ошибка(400,"Некорректные даты выдачи"); КонецЕсли;
  Если Объект.ДатаВыдачи<Объект.Экземпляр.ДатаПоступления Тогда Ошибка(400,"Выдача раньше поступления"); КонецЕсли;
  Если ЗначениеЗаполнено(Объект.ФактическийВозврат) И ЗначениеЗаполнено(Объект.ДатаУтери) Тогда Ошибка(400,"Возврат и утеря взаимоисключающие"); КонецЕсли;
  Закрытие=Объект.ФактическийВозврат; Если ЗначениеЗаполнено(Объект.ДатаУтери) Тогда Закрытие=Объект.ДатаУтери; КонецЕсли;
  Если ЗначениеЗаполнено(Закрытие) И (Закрытие<Объект.ДатаВыдачи Или Закрытие>НачалоДня(ТекущаяДата())) Тогда Ошибка(400,"Некорректная дата закрытия"); КонецЕсли;
  Если Объект.ЭтоНовый() Тогда
   Если Не ЕстьДвижение(Объект.Экземпляр) Или Объект.Экземпляр.Состояние<>Перечисления.СостоянияЭкземпляров.Доступен Тогда Ошибка(409,"Экземпляр недоступен для выдачи"); КонецЕсли;
   КонецНовой=Закрытие; Если Не ЗначениеЗаполнено(КонецНовой) Тогда КонецНовой=Дата(3999,12,31); КонецЕсли;
   История=Документы.Выдача.Выбрать();
   Пока История.Следующий() Цикл
    Если Не История.Проведен Или История.Экземпляр<>Объект.Экземпляр Тогда Продолжить; КонецЕсли;
    КонецСтарой=История.ФактическийВозврат; Если ЗначениеЗаполнено(История.ДатаУтери) Тогда КонецСтарой=История.ДатаУтери; КонецЕсли;
    Если Не ЗначениеЗаполнено(КонецСтарой) Тогда КонецСтарой=Дата(3999,12,31); КонецЕсли;
    Если История.ДатаВыдачи<КонецНовой И КонецСтарой>Объект.ДатаВыдачи Тогда Ошибка(409,"Период пересекается с другой выдачей экземпляра"); КонецЕсли;
   КонецЦикла;
  Иначе
   Если Старый.Экземпляр<>Объект.Экземпляр Или Старый.Читатель<>Объект.Читатель Или Старый.ДатаВыдачи<>Объект.ДатаВыдачи Или Старый.ПлановыйВозврат<>Объект.ПлановыйВозврат Или Старый.ВнешнийКод<>Объект.ВнешнийКод Тогда Ошибка(409,"Основные поля выдачи неизменяемы"); КонецЕсли;
   Если Старый.Проведен И Старый.Состояние<>Перечисления.СостоянияВыдач.Активна Тогда Ошибка(409,"Закрытая выдача неизменяема; повтор команды возврата выполняется через API без перезаписи"); КонецЕсли;
   Если Старый.Состояние<>Перечисления.СостоянияВыдач.Активна И (Старый.ФактическийВозврат<>Объект.ФактическийВозврат Или Старый.ДатаУтери<>Объект.ДатаУтери) Тогда Ошибка(409,"Выдача уже закрыта"); КонецЕсли;
  КонецЕсли;
  Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Выдача ГДЕ Экземпляр=&Книга И Проведен И Ссылка<>&Ссылка И Состояние=&Активна");
  Запрос.УстановитьПараметр("Книга",Объект.Экземпляр); Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка); Запрос.УстановитьПараметр("Активна",Перечисления.СостоянияВыдач.Активна);
  Если Не Запрос.Выполнить().Пустой() Тогда Ошибка(409,"У экземпляра уже есть активная выдача"); КонецЕсли;
  Объект.Состояние=Перечисления.СостоянияВыдач.Активна;
  Если ЗначениеЗаполнено(Объект.ФактическийВозврат) Тогда Объект.Состояние=Перечисления.СостоянияВыдач.Возвращена; КонецЕсли;
  Если ЗначениеЗаполнено(Объект.ДатаУтери) Тогда Объект.Состояние=Перечисления.СостоянияВыдач.Утеряна; КонецЕсли;
 Иначе
  Если Объект.Строки.Количество()=0 Тогда Ошибка(400,"Документ должен содержать экземпляры"); КонецЕсли;
  Если Вид="Поступление" Тогда
   Если Не ЗначениеЗаполнено(Объект.Источник) Или Объект.Источник.ПометкаУдаления Тогда Ошибка(400,"Укажите источник поступления"); КонецЕсли;
  Иначе
   Если Не ЗначениеЗаполнено(Объект.Причина) Или Объект.Причина.ПометкаУдаления Тогда Ошибка(400,"Укажите причину списания"); КонецЕсли;
  КонецЕсли;
  Встречены=Новый Соответствие;
  Для Каждого Строка Из Объект.Строки Цикл
   Если Не ЗначениеЗаполнено(Строка.Экземпляр) Или Строка.Экземпляр.ПометкаУдаления Или Строка.Стоимость<0 Тогда Ошибка(400,"Некорректная строка документа"); КонецЕсли;
   Если Встречены.Получить(Строка.Экземпляр)<>Неопределено Тогда Ошибка(409,"Повтор экземпляра в документе"); КонецЕсли;
   Встречены.Вставить(Строка.Экземпляр,Истина);
   Если Вид="Поступление" Тогда
    Если ЕстьДвижение(Строка.Экземпляр) Тогда Ошибка(409,"Экземпляр уже поступил"); КонецЕсли;
   Иначе
    Если Не ЕстьДвижение(Строка.Экземпляр) Или ЕстьДвижение(Строка.Экземпляр,Истина) Или Строка.Экземпляр.Состояние=Перечисления.СостоянияЭкземпляров.Выдан Тогда Ошибка(409,"Списание недоступного экземпляра запрещено"); КонецЕсли;
    Если Объект.Причина.Код="LOSS" И Строка.Экземпляр.Состояние<>Перечисления.СостоянияЭкземпляров.Утерян Тогда Ошибка(400,"Списание по утере требует отметки утери в выдаче"); КонецЕсли;
    Если Объект.Дата<Строка.Экземпляр.ДатаПоступления Тогда Ошибка(400,"Списание раньше поступления"); КонецЕсли;
    ПроверкаИстории=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Выдача ГДЕ Экземпляр=&Книга И Проведен И (ДатаВыдачи>&Дата ИЛИ ФактическийВозврат>&Дата ИЛИ ДатаУтери>&Дата)");
    ПроверкаИстории.УстановитьПараметр("Книга",Строка.Экземпляр); ПроверкаИстории.УстановитьПараметр("Дата",НачалоДня(Объект.Дата));
    Если Не ПроверкаИстории.Выполнить().Пустой() Тогда Ошибка(409,"Списание раньше существующих операций выдачи запрещено"); КонецЕсли;
    Если Строка.Стоимость<>Строка.Экземпляр.Стоимость Тогда Ошибка(400,"Стоимость списания должна совпадать со стоимостью экземпляра"); КонецЕсли;
    Если Строка.Экземпляр.Состояние=Перечисления.СостоянияЭкземпляров.Утерян Тогда
     Если Не ЗначениеЗаполнено(Объект.Выдача) Или Объект.Выдача.Экземпляр<>Строка.Экземпляр Или Объект.Выдача.Состояние<>Перечисления.СостоянияВыдач.Утеряна Или Объект.Читатель<>Объект.Выдача.Читатель Или Объект.Дата<Объект.Выдача.ДатаУтери Или Объект.Причина.Код<>"LOSS" Тогда Ошибка(400,"Укажите выдачу, читателя и причину утери; проверьте дату"); КонецЕсли;
    КонецЕсли;
   КонецЕсли;
  КонецЦикла;
 КонецЕсли;
КонецПроцедуры

Процедура ДокументПриЗаписи(Объект, Вид) Экспорт
 Если Не Объект.Проведен Тогда Возврат; КонецЕсли;
 Если Вид="Выдача" Тогда
  Книга=Объект.Экземпляр.ПолучитьОбъект();
  Книга.Состояние=Перечисления.СостоянияЭкземпляров.Выдан;
  Если Объект.Состояние=Перечисления.СостоянияВыдач.Возвращена Тогда Книга.Состояние=Перечисления.СостоянияЭкземпляров.Доступен; КонецЕсли;
  Если Объект.Состояние=Перечисления.СостоянияВыдач.Утеряна Тогда Книга.Состояние=Перечисления.СостоянияЭкземпляров.Утерян; КонецЕсли;
  Книга.ДополнительныеСвойства.Вставить("ИзУчета",Истина); Книга.Записать();
 Иначе
  Для Каждого Строка Из Объект.Строки Цикл
   Движение=РегистрыСведений.ДвижениеФонда.СоздатьМенеджерЗаписи();
   Движение.Документ=Строка(Объект.Ссылка.УникальныйИдентификатор()); Движение.Экземпляр=Строка.Экземпляр;
   Движение.ДатаДвижения=НачалоДня(Объект.Дата); Движение.Количество=1; Движение.Стоимость=Строка.Стоимость; Движение.Списание=Вид="Списание"; Движение.Записать();
   Книга=Строка.Экземпляр.ПолучитьОбъект();
   Если Вид="Поступление" Тогда
    Книга.Стоимость=Строка.Стоимость; Книга.ДатаПоступления=НачалоДня(Объект.Дата); Книга.Источник=Объект.Источник; Книга.Состояние=Перечисления.СостоянияЭкземпляров.Доступен;
   Иначе Книга.Состояние=Перечисления.СостоянияЭкземпляров.Списан;
   КонецЕсли;
   Книга.ДополнительныеСвойства.Вставить("ИзУчета",Истина); Книга.Записать();
  КонецЦикла;
 КонецЕсли;
 Аудит(Объект,Вид,Объект.ВнешнийКод);
КонецПроцедуры

Функция КнигаJSON(Книга) Экспорт
 Результат = Новый Структура("book_code,title,author,publication_year,udc,cost,received_date,source,status,deleted",Книга.Код,Книга.Наименование,Книга.Автор,Книга.ГодИздания,Книга.УДК,Деньги(Книга.Стоимость),ДатаСтрокой(Книга.ДатаПоступления),Книга.Источник.Код,Строка(Книга.Состояние),Книга.ПометкаУдаления);
 ДобавитьОписание(Результат, Книга);
 Возврат Результат;
КонецФункции

// Описательные поля издания для публичного каталога (аннотация, раздел, выходные данные, обложка).
Процедура ДобавитьОписание(Результат, Книга) Экспорт
 Результат.Вставить("annotation", Книга.Аннотация);
 Результат.Вставить("section", Книга.Раздел);
 Результат.Вставить("publisher", Книга.Издательство);
 Результат.Вставить("isbn", Книга.ISBN);
 Результат.Вставить("pages", Книга.Страниц);
 Результат.Вставить("cover_url", Книга.Обложка);
КонецПроцедуры

Функция ПолеОписания(Ключ) Экспорт
 Поля = Новый Соответствие;
 Поля.Вставить("annotation","Аннотация"); Поля.Вставить("section","Раздел"); Поля.Вставить("publisher","Издательство");
 Поля.Вставить("isbn","ISBN"); Поля.Вставить("pages","Страниц"); Поля.Вставить("cover_url","Обложка");
