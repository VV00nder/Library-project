Функция ОтчетФонда(Запрос)
 ДатаСреза=НачалоДня(ТекущаяДата()); Если Запрос.ПараметрыЗапроса.Получить("date")<>Неопределено Тогда ДатаСреза=ДатаИзJSON(Запрос.ПараметрыЗапроса.Получить("date")); КонецЕсли;
 Начало=Дата(1,1,1); Если Запрос.ПараметрыЗапроса.Получить("from")<>Неопределено Тогда Начало=ДатаИзJSON(Запрос.ПараметрыЗапроса.Получить("from")); КонецЕсли;
 Конец=ДатаСреза; Если Запрос.ПараметрыЗапроса.Получить("to")<>Неопределено Тогда Конец=ДатаИзJSON(Запрос.ПараметрыЗапроса.Получить("to")); КонецЕсли;
 Если Конец<Начало Тогда Ошибка(400,"Конец периода раньше начала"); КонецЕсли;
 Количество=0; Стоимость=0; НачКоличество=0; НачСтоимость=0; Приход=0; Расход=0; ПриходСумма=0; РасходСумма=0;
 Группы=Новый Соответствие;
 Список=Новый Массив; Выборка=РегистрыСведений.ДвижениеФонда.Выбрать();
 Пока Выборка.Следующий() Цикл
  Знак=1; Если Выборка.Списание Тогда Знак=-1; КонецЕсли;
  Если Выборка.ДатаДвижения<=ДатаСреза Тогда Количество=Количество+Знак; Стоимость=Стоимость+Знак*Выборка.Стоимость; КонецЕсли;
  Если Выборка.ДатаДвижения<Начало Тогда НачКоличество=НачКоличество+Знак; НачСтоимость=НачСтоимость+Знак*Выборка.Стоимость; КонецЕсли;
  Если Выборка.ДатаДвижения<Начало Или Выборка.ДатаДвижения>Конец Тогда Продолжить; КонецЕсли;
  Если Выборка.Списание Тогда
   Расход=Расход+1; РасходСумма=РасходСумма+Выборка.Стоимость; Документ=Документы.Списание.ПолучитьСсылку(Новый УникальныйИдентификатор(Выборка.Документ)); Группа=Документ.Причина.Код;
  Иначе
   Приход=Приход+1; ПриходСумма=ПриходСумма+Выборка.Стоимость; Документ=Документы.Поступление.ПолучитьСсылку(Новый УникальныйИдентификатор(Выборка.Документ)); Группа=Документ.Источник.Код;
  КонецЕсли;
  Список.Добавить(Новый Структура("document_id,date,book_code,writeoff,group,cost",Документ.ВнешнийКод,ДатаСтрокой(Выборка.ДатаДвижения),Выборка.Экземпляр.Код,Выборка.Списание,Группа,Деньги(Выборка.Стоимость)));
  КлючГруппы=Строка(Выборка.Списание)+"|"+Группа;
  ИтогГруппы=Группы.Получить(КлючГруппы);
  Если ИтогГруппы=Неопределено Тогда ИтогГруппы=Новый Структура("writeoff,group,count,amount",Выборка.Списание,Группа,0,0); Группы.Вставить(КлючГруппы,ИтогГруппы); КонецЕсли;
  ИтогГруппы.count=ИтогГруппы.count+1; ИтогГруппы.amount=ИтогГруппы.amount+Выборка.Стоимость;
 КонецЦикла;
 ГруппыJSON=Новый Массив;
 Для Каждого Пара Из Группы Цикл ГруппыJSON.Добавить(Новый Структура("writeoff,group,count,cost",Пара.Значение.writeoff,Пара.Значение.group,Пара.Значение.count,Деньги(Пара.Значение.amount))); КонецЦикла;
 Возврат Новый Структура("items,total,date,count,cost,opening_count,opening_cost,received_count,received_cost,writtenoff_count,writtenoff_cost,closing_count,closing_cost,groups",Список,Список.Количество(),ДатаСтрокой(ДатаСреза),Количество,Деньги(Стоимость),НачКоличество,Деньги(НачСтоимость),Приход,Деньги(ПриходСумма),Расход,Деньги(РасходСумма),НачКоличество+Приход-Расход,Деньги(НачСтоимость+ПриходСумма-РасходСумма),ГруппыJSON);
КонецФункции


// ===== Служебные ресурсы сервера приложения (вызываются пользователем с ролью ОбменБиблиус) =====

Функция Служебный(Запрос, Ресурс) Экспорт
 Попытка
  Если Ресурс = "register" Тогда
   Возврат БиблиусДанные.JSONОтвет(200, Регистрация(БиблиусДанные.ИзJSON(Запрос.ПолучитьТелоКакСтроку())));
  ИначеЕсли Ресурс = "link" Тогда
   Если Запрос.HTTPМетод = "GET" Тогда Возврат БиблиусДанные.JSONОтвет(200, СведенияДляПривязки(Запрос.ПараметрыЗапроса.Получить("reader_id"))); КонецЕсли;
   Возврат БиблиусДанные.JSONОтвет(200, ПривязатьБилет(БиблиусДанные.ИзJSON(Запрос.ПолучитьТелоКакСтроку())));
  ИначеЕсли Ресурс = "notify-due" Тогда
   Возврат БиблиусДанные.JSONОтвет(200, КУведомлению(Запрос));
  ИначеЕсли Ресурс = "notify-log" Тогда
   Если Запрос.HTTPМетод = "GET" Тогда Возврат БиблиусДанные.JSONОтвет(200, ЖурналОтправки()); КонецЕсли;
   Возврат БиблиусДанные.JSONОтвет(200, ЗаписатьОтправку(БиблиусДанные.ИзJSON(Запрос.ПолучитьТелоКакСтроку())));
  КонецЕсли;
  Ошибка(404, "Ресурс не найден");
 Исключение
  Описание = ОписаниеОшибки(); Код = 400; Сообщение = "Проверьте данные запроса";
  Для Каждого Проверка Из СтрРазделить("400,403,404,409", ",") Цикл
   Позиция = СтрНайти(Описание, Проверка + "|");
   Если Позиция > 0 Тогда Код = Число(Проверка); Сообщение = СтрРазделить(Сред(Описание, Позиция + 4), Символы.ПС)[0]; Прервать; КонецЕсли;
  КонецЦикла;
  Возврат БиблиусДанные.JSONОтвет(Код, Новый Структура("code,message", "BUSINESS_ERROR", Сообщение));
 КонецПопытки;
КонецФункции

Функция Регистрация(Данные)
 Логин = ""; Хеш = ""; Имя = "";
 Если Не Данные.Свойство("id", Логин) Или Не Данные.Свойство("password_hash", Хеш) Тогда Ошибка(400, "Укажите логин и пароль"); КонецЕсли;
 Данные.Свойство("name", Имя); Если Имя = Неопределено Или ПустаяСтрока(Имя) Тогда Имя = Логин; КонецЕсли;
 Если Не Справочники.ВебАккаунты.НайтиПоКоду(Логин).Пустая() Тогда Ошибка(409, "Этот логин уже занят"); КонецЕсли;
 Объект = Справочники.ВебАккаунты.СоздатьЭлемент();
 Объект.Код = Логин; Объект.Наименование = Имя; Объект.ХешПароля = Хеш;
 Объект.Роль = Перечисления.РолиВеб.Читатель; Объект.Активен = Истина;
 Объект.Записать();
 Возврат Новый Структура("id,role,reader_id", Логин, "reader", "");
КонецФункции

Функция СведенияДляПривязки(КодЧитателя)
 Если КодЧитателя = Неопределено Тогда КодЧитателя = ""; КонецЕсли;
 Читатель = Справочники.Читатели.НайтиПоКоду(КодЧитателя);
 Если Читатель.Пустая() Или Читатель.ПометкаУдаления Тогда Ошибка(404, "Читательский билет не найден"); КонецЕсли;
 Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Код ИЗ Справочник.ВебАккаунты ГДЕ Читатель = &Читатель И НЕ ПометкаУдаления");
 Запрос.УстановитьПараметр("Читатель", Читатель);
 Возврат Новый Структура("reader_id,full_name,email,linked", Читатель.Код, Читатель.Наименование, Читатель.ЭлектроннаяПочта, Не Запрос.Выполнить().Пустой());
КонецФункции

Функция ПривязатьБилет(Данные)
 НачатьТранзакцию();
 Попытка
  Блокировка = Новый БлокировкаДанных; Блокировка.Добавить("Справочник.ВебАккаунты"); Блокировка.Заблокировать();
  Сведения = СведенияДляПривязки(Данные.reader_id);
  Если Сведения.linked Тогда Ошибка(409, "Этот билет уже привязан к другой учётной записи"); КонецЕсли;
  Ссылка = Справочники.ВебАккаунты.НайтиПоКоду(Данные.account);
  Если Ссылка.Пустая() Или Ссылка.Роль <> Перечисления.РолиВеб.Читатель Тогда Ошибка(404, "Учётная запись не найдена"); КонецЕсли;
  Объект = Ссылка.ПолучитьОбъект();
  Если ЗначениеЗаполнено(Объект.Читатель) Тогда Ошибка(409, "К учётной записи уже привязан билет"); КонецЕсли;
  Объект.Читатель = Справочники.Читатели.НайтиПоКоду(Данные.reader_id);
  Объект.Записать();
  Запись = РегистрыСведений.ЖурналОпераций.СоздатьМенеджерЗаписи();
  Запись.Событие = Строка(Новый УникальныйИдентификатор);
  Запись.ВремяСобытия = Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-dd'T'HH:mm:ss") + "+00:00";
  Запись.Исполнитель = Объект.Код; Запись.Объект = "УчётнаяЗапись"; Запись.КлючОбъекта = Объект.Код; Запись.Действие = "ПривязкаБилета " + Данные.reader_id;
  Запись.Записать();
  ЗафиксироватьТранзакцию();
 Исключение
  ОтменитьТранзакцию(); ВызватьИсключение;
 КонецПопытки;
 Возврат Новый Структура("id,role,reader_id", Данные.account, "reader", Данные.reader_id);
КонецФункции

// FR-20: активные выдачи с адресами для напоминаний; расчёт просрочки — по тем же правилам, что и в отчёте.
Функция КУведомлению(Запрос)
 ДатаСреза = НачалоДня(ТекущаяДата());
 Если Запрос.ПараметрыЗапроса.Получить("date") <> Неопределено Тогда ДатаСреза = ДатаИзJSON(Запрос.ПараметрыЗапроса.Получить("date")); КонецЕсли;
 Список = Новый Массив;
 Выборка = Документы.Выдача.Выбрать();
 Пока Выборка.Следующий() Цикл
  Если Не Выборка.Проведен Или Выборка.ПометкаУдаления Тогда Продолжить; КонецЕсли;
  Карточка = ВыдачаJSON(Выборка, ДатаСреза);
  Если Не Карточка.active Тогда Продолжить; КонецЕсли;
  Карточка.Вставить("email", Выборка.Читатель.ЭлектроннаяПочта);
  Карточка.Вставить("days_left", (Выборка.ПлановыйВозврат - ДатаСреза) / 86400);
  Список.Добавить(Карточка);
 КонецЦикла;
 Возврат Новый Структура("items,date", Список, ДатаСтрокой(ДатаСреза));
КонецФункции

Функция ЗаписатьОтправку(Данные)
 Запись = РегистрыСведений.ОтправкиУведомлений.СоздатьМенеджерЗаписи();
 Запись.КлючОтправки = Данные.key; Запись.Прочитать();
 Если Запись.Выбран() И Запись.Состояние = "Отправлено" Тогда Возврат Новый Структура("key,status,duplicate", Данные.key, Запись.Состояние, Истина); КонецЕсли;
 Запись.КлючОтправки = Данные.key;
 Запись.Выдача = ДокументПоКоду("Выдача", Данные.loan_id);
 Запись.Вид = Данные.kind; Запись.Срок = ДатаИзJSON(Данные.due_date);
 Запись.Адресат = Данные.email; Запись.Состояние = Данные.status; Запись.ВремяПопытки = Данные.time;
 Запись.Записать();
 Возврат Новый Структура("key,status,duplicate", Данные.key, Данные.status, Ложь);
КонецФункции

Функция ЖурналОтправки() Экспорт
 Список = Новый Массив;
 Выборка = РегистрыСведений.ОтправкиУведомлений.Выбрать();
 Пока Выборка.Следующий() Цикл
  КодВыдачи = ""; Если ЗначениеЗаполнено(Выборка.Выдача) Тогда КодВыдачи = Выборка.Выдача.ВнешнийКод; КонецЕсли;
  Список.Добавить(Новый Структура("key,loan_id,kind,due_date,email,status,time", Выборка.КлючОтправки, КодВыдачи, Выборка.Вид, ДатаСтрокой(Выборка.Срок), Выборка.Адресат, Выборка.Состояние, Выборка.ВремяПопытки));
 КонецЦикла;
 Возврат Новый Структура("items,total", Список, Список.Количество());
КонецФункции

// FR-19: средняя и медианная просрочка, ТОП-N читателей и изданий (ПР-02: выборка — выдачи с days_overdue > 0 на дату среза).
Функция СтатистикаПросрочек(Запрос) Экспорт
 ДатаСреза = НачалоДня(ТекущаяДата());
 Если Запрос.ПараметрыЗапроса.Получить("date") <> Неопределено Тогда ДатаСреза = ДатаИзJSON(Запрос.ПараметрыЗапроса.Получить("date")); КонецЕсли;
 N = 5; Если Запрос.ПараметрыЗапроса.Получить("top") <> Неопределено Тогда N = Мин(50, Макс(1, Число(Запрос.ПараметрыЗапроса.Получить("top")))); КонецЕсли;
 Дни = Новый Массив; Сумма = 0;
 Читатели = Новый ТаблицаЗначений;
 Для Каждого Колонка Из СтрРазделить("reader_id,full_name,group,ключ", ",") Цикл Читатели.Колонки.Добавить(Колонка); КонецЦикла;
 Читатели.Колонки.Добавить("loans", Новый ОписаниеТипов("Число")); Читатели.Колонки.Добавить("days", Новый ОписаниеТипов("Число"));
 Книги = Читатели.СкопироватьКолонки();
 Книги.Колонки.Добавить("title"); Книги.Колонки.Добавить("author");
 Выборка = Документы.Выдача.Выбрать();
 Пока Выборка.Следующий() Цикл
  Если Не Выборка.Проведен Или Выборка.ПометкаУдаления Или Выборка.ДатаВыдачи > ДатаСреза Тогда Продолжить; КонецЕсли;
  Карточка = ВыдачаJSON(Выборка, ДатаСреза);
  Если Карточка.days_overdue <= 0 Или Не ФильтрВыдачиЭкспорт(Карточка, Запрос) Тогда Продолжить; КонецЕсли;
  Дни.Добавить(Карточка.days_overdue); Сумма = Сумма + Карточка.days_overdue;
  С = Читатели.Добавить(); С.reader_id = Карточка.reader_id; С.full_name = Карточка.full_name; С.group = Карточка.group; С.ключ = Карточка.reader_id; С.loans = 1; С.days = Карточка.days_overdue;
  К = Книги.Добавить(); К.title = Карточка.title; К.author = Карточка.author; К.ключ = Карточка.title + "|" + Карточка.author; К.loans = 1; К.days = Карточка.days_overdue;
 КонецЦикла;
 Количество = Дни.Количество();
 Среднее = Неопределено; Медиана = Неопределено;
 Если Количество > 0 Тогда
  Среднее = Окр(Сумма / Количество, 2);
  Список = Новый СписокЗначений; Список.ЗагрузитьЗначения(Дни); Список.СортироватьПоЗначению();
  Если Количество % 2 = 1 Тогда Медиана = Список[(Количество - 1) / 2].Значение;
  Иначе Медиана = (Список[Количество / 2 - 1].Значение + Список[Количество / 2].Значение) / 2; КонецЕсли;
 КонецЕсли;
 Читатели.Свернуть("ключ,reader_id,full_name,group", "loans,days"); Читатели.Сортировать("days Убыв, reader_id Возр");
 Книги.Свернуть("ключ,title,author", "loans,days"); Книги.Сортировать("days Убыв, title Возр");
 ТопЧитатели = Новый Массив; ТопКниги = Новый Массив;
 Для Индекс = 0 По Мин(N, Читатели.Количество()) - 1 Цикл С = Читатели[Индекс]; ТопЧитатели.Добавить(Новый Структура("reader_id,full_name,group,loans,days", С.reader_id, С.full_name, С.group, С.loans, С.days)); КонецЦикла;
 Для Индекс = 0 По Мин(N, Книги.Количество()) - 1 Цикл К = Книги[Индекс]; ТопКниги.Добавить(Новый Структура("title,author,loans,days", К.title, К.author, К.loans, К.days)); КонецЦикла;
 Возврат Новый Структура("date,count,mean,median,top,top_readers,top_books", ДатаСтрокой(ДатаСреза), Количество, Среднее, Медиана, N, ТопЧитатели, ТопКниги);
КонецФункции
