// Выгрузка отчёта «Движение фонда» в CSV (T-12, ПР-04): UTF-8, разделитель «;», даты YYYY-MM-DD, точка в суммах.
// Запрос совпадает с запросом схемы отчёта Отчеты.ДвижениеФонда.

Функция ДвижениеФондаCSV(Знач Начало, Знач Конец) Экспорт
	Начало = НачалоДня(Начало); Конец = КонецДня(Конец);
	Если Конец < Начало Тогда ВызватьИсключение "Конец периода раньше начала"; КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ 1 КАК Порядок, ""Начальный остаток"" КАК Операция, ""Фонд"" КАК Группа,
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Д.Списание ТОГДА -Д.Количество ИНАЧЕ Д.Количество КОНЕЦ), 0) КАК Количество,
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Д.Списание ТОГДА -Д.Стоимость ИНАЧЕ Д.Стоимость КОНЕЦ), 0) КАК Стоимость
	|ИЗ РегистрСведений.ДвижениеФонда КАК Д ГДЕ Д.ДатаДвижения < &НачалоПериода
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ВЫБОР КОГДА Д.Списание ТОГДА 3 ИНАЧЕ 2 КОНЕЦ, ВЫБОР КОГДА Д.Списание ТОГДА ""Списание"" ИНАЧЕ ""Поступление"" КОНЕЦ,
	|	ВЫБОР КОГДА Д.Списание ТОГДА С.Ссылка.Причина.Наименование ИНАЧЕ Д.Экземпляр.Источник.Наименование КОНЕЦ,
	|	СУММА(Д.Количество), СУММА(Д.Стоимость)
	|ИЗ РегистрСведений.ДвижениеФонда КАК Д
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.Списание.Строки КАК С ПО Д.Экземпляр = С.Экземпляр И С.Ссылка.Проведен
	|ГДЕ Д.ДатаДвижения МЕЖДУ &НачалоПериода И &КонецПериода
	|СГРУППИРОВАТЬ ПО Д.Списание, ВЫБОР КОГДА Д.Списание ТОГДА С.Ссылка.Причина.Наименование ИНАЧЕ Д.Экземпляр.Источник.Наименование КОНЕЦ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ 4, ""Конечный остаток"", ""Фонд"",
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Д.Списание ТОГДА -Д.Количество ИНАЧЕ Д.Количество КОНЕЦ), 0),
	|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Д.Списание ТОГДА -Д.Стоимость ИНАЧЕ Д.Стоимость КОНЕЦ), 0)
	|ИЗ РегистрСведений.ДвижениеФонда КАК Д ГДЕ Д.ДатаДвижения <= &КонецПериода
	|УПОРЯДОЧИТЬ ПО Порядок, Группа");
	Запрос.УстановитьПараметр("НачалоПериода", Начало);
	Запрос.УстановитьПараметр("КонецПериода", Конец);
	Строки = Новый Массив;
	Строки.Добавить("period_start;period_end;operation;group;quantity;cost");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(СтрШаблон("%1;%2;%3;%4;%5;%6",
			Формат(Начало, "ДФ=yyyy-MM-dd"), Формат(Конец, "ДФ=yyyy-MM-dd"),
			ПолеCSV(Выборка.Операция), ПолеCSV(Выборка.Группа),
			Формат(Выборка.Количество, "ЧДЦ=0; ЧН=0; ЧГ=0"),
			Формат(Выборка.Стоимость, "ЧДЦ=2; ЧРД=.; ЧН=0.00; ЧГ=0")));
	КонецЦикла;
	Данные = ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Строки, Символы.ВК + Символы.ПС) + Символы.ВК + Символы.ПС, КодировкаТекста.UTF8, Истина);
	Возврат ПоместитьВоВременноеХранилище(Данные, Новый УникальныйИдентификатор);
КонецФункции

Функция ПолеCSV(Значение)
	Текст = Строка(Значение);
	Если СтрНайти(Текст, ";") > 0 Или СтрНайти(Текст, """") > 0 Или СтрНайти(Текст, Символы.ПС) > 0 Тогда
		Возврат """" + СтрЗаменить(Текст, """", """""") + """";
	КонецЕсли;
	Возврат Текст;
КонецФункции
