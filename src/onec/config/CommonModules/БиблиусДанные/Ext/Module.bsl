Функция JSONОтвет(Код, Данные) Экспорт
    Писатель = Новый ЗаписьJSON;
    Писатель.УстановитьСтроку();
    ЗаписатьJSON(Писатель, Данные);
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.Заголовки.Вставить("Cache-Control", "no-store");
    Ответ.УстановитьТелоИзСтроки(Писатель.Закрыть(), КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции

Функция ИзJSON(СтрокаJSON) Экспорт
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(СтрокаJSON);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

Функция КарточкаЧитателя(Запись) Экспорт
    Возврат Новый Структура("reader_id,full_name,group,email,deleted", Запись.Код, Запись.Наименование, Запись.Группа, Запись.ЭлектроннаяПочта, Запись.ПометкаУдаления);
КонецФункции

Функция Обработать(Запрос) Экспорт
    // Доступ к обмену: только служебный пользователь сервера приложения (роль ОбменБиблиус) или администратор.
    Если Не РольДоступна("ОбменБиблиус") И Не РольДоступна("АдминистраторБиблиус") Тогда
        Возврат JSONОтвет(403, Новый Структура("code,message", "FORBIDDEN", "Нет доступа к обмену"));
    КонецЕсли;
    Попытка
        Ресурс = Запрос.ПараметрыURL["resource"];
        Если Ресурс = "setup" Тогда
            Возврат Настройка(Запрос);
        КонецЕсли;
        Если Ресурс = "register" Или Ресурс = "link" Или Ресурс = "notify-due" Или Ресурс = "notify-log" Тогда
            Возврат БиблиусУчет.Служебный(Запрос, Ресурс);
        КонецЕсли;
        Если Ресурс = "public-catalog" И Запрос.HTTPМетод = "GET" Тогда
            Возврат JSONОтвет(200, БиблиусУчет.ПубличныйКаталог());
        КонецЕсли;
        Если Ресурс = "account" Тогда
            Логин = Запрос.ПараметрыЗапроса.Получить("login");
            Аккаунт = Справочники.ВебАккаунты.НайтиПоКоду(Логин);
            Если Аккаунт.Пустая() Или Аккаунт.ПометкаУдаления Или Не Аккаунт.Активен Тогда
                Возврат JSONОтвет(401, Новый Структура("code,message", "UNAUTHORIZED", "Неверные учётные данные"));
            КонецЕсли;
            Возврат JSONОтвет(200, Новый Структура("id,password_hash,role,reader_id", Аккаунт.Код, Аккаунт.ХешПароля, Строка(Аккаунт.Роль), Аккаунт.Читатель.Код));
        КонецЕсли;
        Исполнитель = Справочники.ВебАккаунты.НайтиПоКоду(Запрос.Заголовки.Получить("X-Biblius-Actor"));
        Если Исполнитель.Пустая() Или Исполнитель.ПометкаУдаления Или Не Исполнитель.Активен Тогда
            Возврат JSONОтвет(401, Новый Структура("code,message", "UNAUTHORIZED", "Войдите в систему"));
        КонецЕсли;
        Если Ресурс <> "readers" Тогда
            Возврат БиблиусУчет.API(Запрос, Исполнитель, Ресурс);
        КонецЕсли;
        Если Исполнитель.Роль <> Перечисления.РолиВеб.Библиотекарь Тогда
            Возврат JSONОтвет(403, Новый Структура("code,message", "FORBIDDEN", "Действие доступно библиотекарю"));
        КонецЕсли;
        Если Ресурс <> "readers" Тогда
            Возврат JSONОтвет(404, Новый Структура("code,message", "NOT_FOUND", "Ресурс не найден"));
        КонецЕсли;
        Ид = Запрос.ПараметрыЗапроса.Получить("id");
        Если Ид = Неопределено Тогда Ид = ""; КонецЕсли;
        Если Запрос.HTTPМетод = "GET" Тогда
            Если Не ПустаяСтрока(Ид) Тогда
                Запись = Справочники.Читатели.НайтиПоКоду(Ид);
                Если Запись.Пустая() Тогда Возврат JSONОтвет(404, Новый Структура("code,message", "NOT_FOUND", "Читатель не найден")); КонецЕсли;
                Возврат JSONОтвет(200, КарточкаЧитателя(Запись));
            КонецЕсли;
            Список = Новый Массив;
            Выборка = Справочники.Читатели.Выбрать();
            Пока Выборка.Следующий() Цикл
                Если Не Выборка.ПометкаУдаления Тогда Список.Добавить(КарточкаЧитателя(Выборка)); КонецЕсли;
            КонецЦикла;
            Возврат JSONОтвет(200, Новый Структура("items,total", Список, Список.Количество()));
        КонецЕсли;
        НачатьТранзакцию();
        Попытка
            Блокировка = Новый БлокировкаДанных;
            Блокировка.Добавить("Справочник.Читатели");
            Блокировка.Заблокировать();
            Если Запрос.HTTPМетод = "POST" Тогда
                Данные = ИзJSON(Запрос.ПолучитьТелоКакСтроку());
                Если Не Данные.Свойство("reader_id", Ид) Тогда ВызватьИсключение "BAD_DATA"; КонецЕсли;
                Если Не Справочники.Читатели.НайтиПоКоду(Ид).Пустая() Тогда
                    ОтменитьТранзакцию(); Возврат JSONОтвет(409, Новый Структура("code,message", "CONFLICT", "Код читателя уже занят"));
                КонецЕсли;
                Объект = Справочники.Читатели.СоздатьЭлемент(); Объект.Код = Ид;
            Иначе
                Ссылка = Справочники.Читатели.НайтиПоКоду(Ид);
                Если Ссылка.Пустая() Тогда ОтменитьТранзакцию(); Возврат JSONОтвет(404, Новый Структура("code,message", "NOT_FOUND", "Читатель не найден")); КонецЕсли;
                Объект = Ссылка.ПолучитьОбъект();
                Объект.ДополнительныеСвойства.Вставить("ИсполнительВеб", Исполнитель.Код);
                Если Объект.ПометкаУдаления Тогда ОтменитьТранзакцию(); Возврат JSONОтвет(409, Новый Структура("code,message", "CONFLICT", "Читатель помечен на удаление")); КонецЕсли;
                Если Запрос.HTTPМетод = "DELETE" Тогда
                    ЗапросСвязей = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Выдача ГДЕ Читатель = &Читатель");
                    ЗапросСвязей.УстановитьПараметр("Читатель", Ссылка);
                    Если Не ЗапросСвязей.Выполнить().Пустой() Тогда ОтменитьТранзакцию(); Возврат JSONОтвет(409, Новый Структура("code,message", "HAS_HISTORY", "У читателя есть история выдач")); КонецЕсли;
                    Объект.УстановитьПометкуУдаления(Истина);
                ИначеЕсли Запрос.HTTPМетод = "PATCH" Тогда
                    Данные = ИзJSON(Запрос.ПолучитьТелоКакСтроку());
                Иначе
                    ОтменитьТранзакцию(); Возврат JSONОтвет(405, Новый Структура("code,message", "METHOD_NOT_ALLOWED", "Метод не поддерживается"));
                КонецЕсли;
            КонецЕсли;
            Если Запрос.HTTPМетод <> "DELETE" Тогда
                Значение = Неопределено;
                Для Каждого Поле Из Данные Цикл
                    Если ТипЗнч(Поле.Значение) <> Тип("Строка") Тогда ВызватьИсключение "BAD_DATA"; КонецЕсли;
                    Если Поле.Ключ = "reader_id" Тогда Лимит = 40;
                    ИначеЕсли Поле.Ключ = "full_name" Тогда Лимит = 200;
                    ИначеЕсли Поле.Ключ = "group" Тогда Лимит = 80;
                    ИначеЕсли Поле.Ключ = "email" Тогда Лимит = 254;
                    Иначе ВызватьИсключение "BAD_DATA";
                    КонецЕсли;
                    Если СтрДлина(Поле.Значение) > Лимит Тогда ВызватьИсключение "BAD_DATA"; КонецЕсли;
                КонецЦикла;
                Если Данные.Свойство("full_name", Значение) Тогда Объект.Наименование = Значение; КонецЕсли;
                Если Данные.Свойство("group", Значение) Тогда Объект.Группа = Значение; КонецЕсли;
                Если Данные.Свойство("email", Значение) Тогда Объект.ЭлектроннаяПочта = Значение; КонецЕсли;
                Если ПустаяСтрока(Объект.Код) Или ПустаяСтрока(Объект.Наименование) Или ПустаяСтрока(Объект.Группа) Тогда ВызватьИсключение "BAD_DATA"; КонецЕсли;
                Объект.ДополнительныеСвойства.Вставить("ИсполнительВеб", Исполнитель.Код);
                Объект.Записать();
            КонецЕсли;
            ЗафиксироватьТранзакцию();
            Возврат JSONОтвет(200, КарточкаЧитателя(Объект));
        Исключение
            ОтменитьТранзакцию(); ВызватьИсключение;
        КонецПопытки;
    Исключение
        Возврат JSONОтвет(400, Новый Структура("code,message", "BAD_DATA", "Проверьте поля и связи записи"));
    КонецПопытки;
КонецФункции

// Начальная настройка веб-доступа: учётные записи и справочники.
// Вызывается сервером приложения (скрипт seed). Повторный вызов обновляет записи.
Функция Настройка(Запрос) Экспорт
    Если Запрос.HTTPМетод <> "POST" Тогда
        Возврат JSONОтвет(405, Новый Структура("code,message", "METHOD_NOT_ALLOWED", "Используйте POST"));
    КонецЕсли;
    Данные = ИзJSON(Запрос.ПолучитьТелоКакСтроку());
    Итог = Новый Структура("accounts,sources,reasons,errors", 0, 0, 0, Новый Массив);
    НачатьТранзакцию();
    Попытка
        Значение = Неопределено;
        Если Данные.Свойство("sources", Значение) Тогда
            Для Каждого Элемент Из Значение Цикл
                Если Справочники.ИсточникиПоступления.НайтиПоКоду(Элемент.code).Пустая() Тогда
                    Объект = Справочники.ИсточникиПоступления.СоздатьЭлемент(); Объект.Код = Элемент.code; Объект.Наименование = Элемент.name; Объект.Записать();
                    Итог.sources = Итог.sources + 1;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если Данные.Свойство("reasons", Значение) Тогда
            Для Каждого Элемент Из Значение Цикл
                Если Справочники.ПричиныСписания.НайтиПоКоду(Элемент.code).Пустая() Тогда
                    Объект = Справочники.ПричиныСписания.СоздатьЭлемент(); Объект.Код = Элемент.code; Объект.Наименование = Элемент.name; Объект.Записать();
                    Итог.reasons = Итог.reasons + 1;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если Данные.Свойство("accounts", Значение) Тогда
            Для Каждого Элемент Из Значение Цикл
                Ссылка = Справочники.ВебАккаунты.НайтиПоКоду(Элемент.id);
                Если Ссылка.Пустая() Тогда
                    Объект = Справочники.ВебАккаунты.СоздатьЭлемент(); Объект.Код = Элемент.id;
                Иначе
                    Объект = Ссылка.ПолучитьОбъект();
                КонецЕсли;
                Объект.Наименование = Элемент.name; Объект.ХешПароля = Элемент.password_hash; Объект.Активен = Истина;
                Объект.Читатель = Справочники.Читатели.ПустаяСсылка();
                Если Элемент.role = "reader" Тогда
                    Объект.Роль = Перечисления.РолиВеб.Читатель;
                    Объект.Читатель = Справочники.Читатели.НайтиПоКоду(Элемент.reader_id);
                    Если Объект.Читатель.Пустая() Тогда
                        Итог.errors.Добавить("Читатель " + Элемент.reader_id + " не найден для " + Элемент.id);
                        Продолжить;
                    КонецЕсли;
                ИначеЕсли Элемент.role = "accountant" Тогда
                    Объект.Роль = Перечисления.РолиВеб.Бухгалтер;
                Иначе
                    Объект.Роль = Перечисления.РолиВеб.Библиотекарь;
                КонецЕсли;
                Объект.Записать();
                Итог.accounts = Итог.accounts + 1;
            КонецЦикла;
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        Возврат JSONОтвет(400, Новый Структура("code,message", "BAD_DATA", "Ошибка настройки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
    КонецПопытки;
    Возврат JSONОтвет(200, Итог);
КонецФункции

Процедура ЗагрузитьНабор(ИмяФайла) Экспорт
    Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество()>0 И Не РольДоступна("АдминистраторБиблиус") Тогда
        ВызватьИсключение "Начальное заполнение доступно только администратору";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(ИмяФайла);
    Данные = ПрочитатьJSON(Чтение); Чтение.Закрыть();
    Если ПустаяСтрока(Константы.КлючОбмена.Получить()) Тогда Константы.КлючОбмена.Установить(Данные.exchange_key); КонецЕсли;
    Для Каждого Строка Из Данные.readers Цикл
        Если Справочники.Читатели.НайтиПоКоду(Строка.reader_id).Пустая() Тогда
            Объект = Справочники.Читатели.СоздатьЭлемент(); Объект.Код = Строка.reader_id;
            Объект.Наименование = Строка.full_name; Объект.Группа = Строка.group;
            Объект.ЭлектроннаяПочта = Строка.email; Объект.Записать();
        КонецЕсли;
    КонецЦикла;
    Для Каждого Строка Из Данные.accounts Цикл
        Если Справочники.ВебАккаунты.НайтиПоКоду(Строка.id).Пустая() Тогда
            Объект = Справочники.ВебАккаунты.СоздатьЭлемент(); Объект.Код = Строка.id;
            Объект.Наименование = Строка.id; Объект.ХешПароля = Строка.password_hash;
            Объект.Роль = Перечисления.РолиВеб.Библиотекарь; Объект.Активен = Истина; Объект.Записать();
            Роль=Неопределено;
            Если Строка.Свойство("role",Роль) Тогда
                Если Роль="reader" Тогда Объект.Роль=Перечисления.РолиВеб.Читатель; Объект.Читатель=Справочники.Читатели.НайтиПоКоду(Строка.reader_id); КонецЕсли;
                Если Роль="accountant" Тогда Объект.Роль=Перечисления.РолиВеб.Бухгалтер; КонецЕсли;
                Объект.Записать();
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Для Каждого Код Из СтрРазделить("DEMO,DONATION,PURCHASE",",") Цикл
        Если Справочники.ИсточникиПоступления.НайтиПоКоду(Код).Пустая() Тогда
            Объект=Справочники.ИсточникиПоступления.СоздатьЭлемент(); Объект.Код=Код; Объект.Наименование=Код; Объект.Записать();
        КонецЕсли;
    КонецЦикла;
    Для Каждого Код Из СтрРазделить("LOSS,DAMAGE,OBSOLETE",",") Цикл
        Если Справочники.ПричиныСписания.НайтиПоКоду(Код).Пустая() Тогда
            Объект=Справочники.ПричиныСписания.СоздатьЭлемент(); Объект.Код=Код; Объект.Наименование=Код; Объект.Записать();
        КонецЕсли;
    КонецЦикла;
    Нативные=Неопределено;
    Если Данные.Свойство("native_users",Нативные) Тогда
        Для Каждого Настройка Из Нативные Цикл
            Пользователь=ПользователиИнформационнойБазы.НайтиПоИмени(Настройка.name);
            Если Пользователь=Неопределено Тогда
                Пользователь=ПользователиИнформационнойБазы.СоздатьПользователя();
                Пользователь.Имя=Настройка.name; Пользователь.ПолноеИмя=Настройка.name;
                Пользователь.АутентификацияСтандартная=Истина;
                Пользователь.Пароль=Настройка.password;
                Пользователь.ПоказыватьВСпискеВыбора=Настройка.role<>"ОбменБиблиус";
                Пользователь.Роли.Добавить(Метаданные.Роли[Настройка.role]);
                Пользователь.Записать();
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры

Процедура АудитЧитателя(Объект) Экспорт
    Исполнитель = ИмяПользователя();
    Объект.ДополнительныеСвойства.Свойство("ИсполнительВеб", Исполнитель);
    Событие = РегистрыСведений.ЖурналОпераций.СоздатьМенеджерЗаписи();
    Событие.Событие = Строка(Новый УникальныйИдентификатор);
    Событие.ВремяСобытия = Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-dd'T'HH:mm:ss") + "+00:00";
    Событие.Исполнитель = Исполнитель; Событие.Действие = "Запись";
    Если Объект.ПометкаУдаления Тогда Событие.Действие = "ПометкаУдаления"; КонецЕсли;
    Событие.Объект = "Читатель"; Событие.КлючОбъекта = Объект.Код;
    Писатель = Новый ЗаписьJSON; Писатель.УстановитьСтроку(); ЗаписатьJSON(Писатель, КарточкаЧитателя(Объект));
    Событие.Изменения = Писатель.Закрыть(); Событие.Записать();
КонецПроцедуры

Функция СтатистикаБазы() Экспорт
    Если Не РольДоступна("АдминистраторБиблиус") Тогда ВызватьИсключение "Требуются права администратора"; КонецЕсли;
    Результат=Новый Структура;
    Для Каждого ИмяТаблицы Из СтрРазделить("Справочник.Экземпляры,Справочник.Читатели,Справочник.ВебАккаунты,Документ.Выдача,Документ.Поступление,Документ.Списание,РегистрСведений.ДвижениеФонда,РегистрСведений.ЖурналОпераций",",") Цикл
        Запрос=Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ "+ИмяТаблицы);
        Выборка=Запрос.Выполнить().Выбрать(); Выборка.Следующий();
        Результат.Вставить(СтрЗаменить(ИмяТаблицы,".","_"),Выборка.Количество);
    КонецЦикла;
    Возврат Результат;
КонецФункции
